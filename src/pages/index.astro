---
import Base from '../layouts/Base.astro';
import { buildOutline, href, lessonPath, PLAYGROUNDS, playgroundPath } from '../site';
import { lessonEntries } from '../lib/lessons';

const base = import.meta.env.BASE_URL;
const outline = buildOutline(await lessonEntries());
const first = outline[0].lessons[0];
---

<Base title="Singer Difference Sets" description="An interactive introduction to Singer difference sets, finite fields, and projective planes.">
  <section class="hero">
    <div>
      <h1>Singer Difference Sets</h1>
      <p class="lede">
        Mark 0, 1, and 3 on a clock with seven hours. Every distance from 1 to 6 hours appears exactly once between
        two of the marks. Sets like this look like they need a long search. In 1938 James Singer showed how to write
        one down directly for every prime power, using finite fields and projective planes.
      </p>
      <p><a class="button" href={href(base, lessonPath(first.id))}>Start with lesson 1: {first.title}</a></p>
    </div>
    <div data-widget="chord-diagram" data-set="0,1,3"></div>
  </section>

  <h2>The path</h2>
  {
    outline.map((part) => (
      <section class="path-part">
        <h3>
          Part {part.numeral}: {part.title}
        </h3>
        <ol class="path-list">
          {part.lessons.map((l) => (
            <li value={l.order}>
              <a href={href(base, lessonPath(l.id))}>{l.title}</a>
              <span class="summary">{l.summary}</span>
            </li>
          ))}
        </ol>
      </section>
    ))
  }

  <h2>Playgrounds</h2>
  <ul class="path-list">
    {
      PLAYGROUNDS.map((pg) => (
        <li>
          <a href={href(base, playgroundPath(pg.slug))}>{pg.title}</a>
          <span class="summary">{pg.summary}</span>
        </li>
      ))
    }
  </ul>
</Base>
