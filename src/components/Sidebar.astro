---
import { buildOutline, href, lessonPath, PLAYGROUNDS, playgroundPath } from '../site';
import { lessonEntries } from '../lib/lessons';

interface Props {
  current?: string;
}

const { current } = Astro.props;
const base = import.meta.env.BASE_URL;
const outline = buildOutline(await lessonEntries());
---

<nav class="sidebar" id="sidebar" aria-label="Lessons and playgrounds">
  <div class="topic-search" data-index={href(base, 'search-index.json')} data-base={base}>
    <label class="visually-hidden" for="topic-search-input">Search topics</label>
    <input
      id="topic-search-input"
      type="search"
      placeholder="Search topics…"
      autocomplete="off"
      spellcheck="false"
      role="combobox"
      aria-expanded="false"
      aria-controls="topic-search-results"
      aria-autocomplete="list"
    />
    <ul id="topic-search-results" class="topic-search-results" role="listbox" aria-label="Matching sections" hidden></ul>
  </div>
  <h2 class="sidebar-heading">Lessons</h2>
  {
    outline.map((part) => (
      <section class="sidebar-part">
        <h3>
          <span class="numeral">Part {part.numeral}</span> {part.title}
        </h3>
        <ol>
          {part.lessons.map((lesson) => {
            const path = lessonPath(lesson.id);
            return (
              <li class:list={[lesson.status]}>
                <a href={href(base, path)} aria-current={current === path ? 'page' : undefined}>
                  <span class="num">{lesson.order}</span>
                  <span class="title">{lesson.title}</span>
                </a>
              </li>
            );
          })}
        </ol>
      </section>
    ))
  }
  <ul class="sidebar-reference">
    <li>
      <a href={href(base, 'glossary/')} aria-current={current === 'glossary/' ? 'page' : undefined}>Glossary</a>
    </li>
    <li>
      <a href={href(base, 'singer-difference-sets.pdf')}>Printable PDF</a>
    </li>
  </ul>
  <h2 class="sidebar-heading">Playgrounds</h2>
  <ul class="sidebar-playgrounds">
    {
      PLAYGROUNDS.map((pg) => {
        const path = playgroundPath(pg.slug);
        return (
          <li>
            <a href={href(base, path)} aria-current={current === path ? 'page' : undefined}>
              {pg.title}
            </a>
          </li>
        );
      })
    }
  </ul>
</nav>
